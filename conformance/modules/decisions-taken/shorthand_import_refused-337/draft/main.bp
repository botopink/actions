//// Decision 337 — The shorthand import goes; `mod m;` binds the namespace `m` in the module that declares it.

import {io.terminal} from "std";
import {state.writeState} from "actions";

mod form;

pub fn main() -> void {
    val state = writeState("Check the form", [#("email", "taken")]);
    terminal.print(form.summary(state));
}
